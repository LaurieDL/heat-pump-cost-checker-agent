# Required. Use a key from Fidesq's own Anthropic account, made just for this
# service, with a monthly spend limit set on its workspace.
ANTHROPIC_API_KEY=

# Optional. Which Claude model answers.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Sites allowed to call /api/chat from the browser, comma separated.
# The service's own page is always allowed.
ALLOWED_ORIGINS=https://fidesq.com,https://www.fidesq.com

# Abuse and cost limits.
RATE_LIMIT_PER_HOUR=40
GLOBAL_LIMIT_PER_DAY=3000
MAX_MESSAGE_CHARS=1200
MAX_TURNS=30
MAX_TOOL_ROUNDS=5
MAX_OUTPUT_TOKENS=1024

# Railway sets PORT itself. Behind Railway's proxy, leave TRUST_PROXY unset.
# PORT=3000
# TRUST_PROXY=false
